{
  "name": "@hilow/extension-types",
  "version": "1.0.0",
  "description": "YAT Extension Type Definitions - Shared types for YAT extension development",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('dist/index.js','dist/index.mjs')\"",
    "build:esm": "node -e \"require('fs').copyFileSync('dist/index.js','dist/index.mjs')\"",
    "prepublishOnly": "npm run build",
    "publish:gitlab": "npm publish"
  },
  "keywords": [
    "yat",
    "extension",
    "types",
    "typescript"
  ],
  "author": "YAT Team",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "publishConfig": {
    "@yat:registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/tunnel6/yat-extension-types.git"
  },
  "bugs": {
    "url": "https://github.com/tunnel6/yat-extension-types/issues"
  },
  "homepage": "https://github.com/tunnel6/yat-extension-types#readme",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
